<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Re-schedule the periodic poll after device reboot and re-apply the delivery mode
             (restart the foreground service if the user chose Fast). -->
        <receiver
            android:name="org.cordn.background.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Fast-delivery foreground service (roadmap §4.2). Polls on a coroutine timer at the
             user-chosen interval; Doze-exempt. Mandatory persistent notification on CHANNEL_SYNC. -->
        <service
            android:name="org.cordn.background.CordnNotificationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps an active call's media capture alive while the WebView is backgrounded
             (screen off / app switch). Both types are declared up front; the service passes
             only the ones actually in use to startForeground. stopWithTask so swiping the app
             away never leaves an orphaned mic notification. -->
        <service
            android:name="org.cordn.background.CallForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="microphone|camera|mediaPlayback" />
    </application>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: required because the service declares foregroundServiceType="dataSync". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 14+: the call service's microphone/camera types. RECORD_AUDIO and CAMERA
         are declared by the app module (voice notes / QR scanner) and merge in. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Muted joins have no mic track: the call still runs as playback, never a silent
         background service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Partial wake lock so audio keeps flowing with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Prompt the user to exempt Cordn from battery optimization (improves Doze reliability). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
